import 'package:material_ui/material_ui.dart';
void main() {
  runApp(const SweetCrumbsApp());
}

// Product model
class Product {
  final int id;
  final String name;
  final double price;
  final String category;
  final String image;
  final String description;

  const Product({
    required this.id,
    required this.name,
    required this.price,
    required this.category,
    required this.image,
    required this.description,
  });
}

